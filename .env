# BrowserAI settings
# Edit the value after the = sign, then save this file.
# Restart BrowserAI after making changes. Do not add quotation marks.

# Browser controlled by the agent: auto (Chrome then Edge), chrome, or edge.
BROWSER_AGENT_BROWSER=auto

# Ollama model name. The launcher will download it if it is not installed.
BROWSER_AGENT_MODEL=phi3

# Local dashboard port. Usually leave this as 5000.
PORT=5000

# Admin password. Leave blank to be asked for a password when BrowserAI starts.
# If you enter a password here, protect this file and do not share it.
BROWSERAI_ADMIN_PASSWORD=

# Invitation code required to open the dashboard. Change this to your own code.
BROWSERAI_INVITE_CODES=465JSMOVvuTykcR0SOP1xoxn

# true enables browser tasks; false disables the agent.
BROWSERAI_AGENT_ENABLED=true

# 0 shows the automation browser window; 1 runs it hidden.
BROWSER_AGENT_HEADLESS=0

# 1 is special visible setup mode; 0 is normal operation.
BROWSER_AGENT_SETUP=0
